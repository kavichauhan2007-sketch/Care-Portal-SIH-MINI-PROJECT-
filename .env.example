# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOCTOR_DASHBOARD_URL=http://localhost:3001

# Node Environment
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_3D_PAIN_MAP=true
NEXT_PUBLIC_ENABLE_AYUSH=true
NEXT_PUBLIC_DEMO_MODE=false

# AI Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash-latest
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# OCR Configuration
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng+hin

# Speech Configuration
STT_PROVIDER=browser
TTS_PROVIDER=browser
SPEECH_LANGUAGE=en-US

# FHIR/ABDM (Mock/Sandbox for SIH Demo)
FHIR_BASE_URL=http://localhost:8080/fhir
ABDM_BASE_URL=https://sandbox.ndhm.gov.in
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret

# Session Configuration
SESSION_TIMEOUT_MINUTES=5
SESSION_WARNING_MINUTES=4

# Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# Security
JWT_SECRET=your_jwt_secret_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
ENCRYPTION_KEY=your_encryption_key_32_chars_min

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS (Optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# Analytics (Optional)
ENABLE_ANALYTICS=false
ANALYTICS_ID=

# Monitoring (Optional)
SENTRY_DSN=
